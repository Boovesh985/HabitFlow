NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/habitflow?schema=public
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=https://your-domain.com,https://localhost,capacitor://localhost
VAPID_PUBLIC_KEY=generate-with-npm-run-vapid
VAPID_PRIVATE_KEY=generate-with-npm-run-vapid
VAPID_SUBJECT=mailto:you@example.com
RUN_SCHEDULER=true
ALLOW_REGISTRATION=true
