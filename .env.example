# Copy to .env and fill in. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   cd server && npm run vapid
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Origins allowed to call the API from a browser. The Android app uses https://localhost.
CORS_ORIGINS=https://localhost,capacitor://localhost
# After creating your own account, set to false to keep the server private.
ALLOW_REGISTRATION=true
APP_PORT=8080
